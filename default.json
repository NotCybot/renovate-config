{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for NotCybot repositories",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    ":semanticCommits",
    ":automergeMinor",
    "group:allNonMajor"
  ],
  "timezone": "Europe/Berlin",
  "prHourlyLimit": 0,
  "schedule": ["* 0-12 1 * *"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "vulnerabilityFixStrategy": "highest",
    "schedule": ["at any time"],
    "automerge": true
  },
  "digest": {
    "automerge": true
  },
  "pinDigest": {
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* 0-12 * * 1"]
  },
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Majors in one PR too, never automerged",
      "matchUpdateTypes": ["major"],
      "groupName": "all major dependencies",
      "groupSlug": "all-major"
    }
  ]
}
