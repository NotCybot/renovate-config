{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for NotCybot repositories",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    ":semanticCommits",
    ":automergeMinor"
  ],
  "timezone": "Europe/Berlin",
  "prHourlyLimit": 0,
  "schedule": ["* * * * 1"],
  "osvVulnerabilityAlerts": true,
  "digest": {
    "automerge": true
  },
  "pinDigest": {
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * * * 1"]
  },
  "nix": {
    "enabled": true
  }
}
